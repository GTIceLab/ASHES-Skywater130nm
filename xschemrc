# Project-local Sky130 setup. Run Xschem from this repo or use scripts/open_xschem.sh.
# Sources: Xschem's Sky130 integration and library-path documentation.
namespace eval ::ashes_sky130 {}
set ::ashes_sky130::repo [file dirname [file normalize [info script]]]

if {![info exists env(PDK_ROOT)] || $env(PDK_ROOT) eq ""} {
    error "Set PDK_ROOT to the installed open_pdks directory containing sky130A (see docs/xschem.md)."
}
set PDK_ROOT [file normalize $env(PDK_ROOT)]
if {![info exists env(PDK)] || $env(PDK) eq ""} {set env(PDK) sky130A}
set PDK $env(PDK)
if {$PDK ni {sky130A sky130B}} {error "This repository requires PDK=sky130A or sky130B."}
set PDKPATH [file join $PDK_ROOT $PDK]
set ::ashes_sky130::pdk_rc [file join $PDKPATH libs.tech xschem xschemrc]
if {![file isfile $::ashes_sky130::pdk_rc]} {
    error "Missing $::ashes_sky130::pdk_rc. Install open_pdks with Xschem support; PDK_ROOT is the parent of $PDK."
}
if {[info exists env(XSCHEM_SHAREDIR)] && $env(XSCHEM_SHAREDIR) ne ""} {
    set XSCHEM_SHAREDIR [file normalize $env(XSCHEM_SHAREDIR)]
}
if {![info exists XSCHEM_SHAREDIR] || ![file isdirectory [file join $XSCHEM_SHAREDIR xschem_library devices]]} {
    error "Xschem's installed devices library was not found. Check the Xschem installation or set XSCHEM_SHAREDIR (see docs/xschem.md)."
}
if {![info exists USER_CONF_DIR]} {set USER_CONF_DIR [file join $env(HOME) .xschem]}

# Load PDK symbols/model configuration before extending its search path.
source $::ashes_sky130::pdk_rc
if {![info exists XSCHEM_LIBRARY_PATH]} {set XSCHEM_LIBRARY_PATH ""}
proc ::ashes_sky130::add_library {directory} {
    global XSCHEM_LIBRARY_PATH
    set directory [file normalize $directory]
    set paths [split $XSCHEM_LIBRARY_PATH :]
    if {$directory ni $paths} {lappend paths $directory}
    set XSCHEM_LIBRARY_PATH [join [lsearch -all -inline -not -exact $paths ""] :]
}
::ashes_sky130::add_library [file join $XSCHEM_SHAREDIR xschem_library]
::ashes_sky130::add_library [file join $XSCHEM_SHAREDIR xschem_library devices]
::ashes_sky130::add_library [file join $PDKPATH libs.tech xschem]
::ashes_sky130::add_library $::ashes_sky130::repo

# Symbol paths use repo-root names, avoiding ambiguous basename searches.
set XSCHEM_START_WINDOW {}
set netlist_dir [file join $::ashes_sky130::repo .xschem netlists]
file mkdir $netlist_dir
set local_netlist_dir 0
set ::ashes_sky130::local_rc [file join $::ashes_sky130::repo xschemrc.local]
if {[file isfile $::ashes_sky130::local_rc]} {source $::ashes_sky130::local_rc}
