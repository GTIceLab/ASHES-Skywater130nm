# KLayout purposes: https://github.com/KLayout/klayout/blob/master/src/plugins/streamers/lefdef/db_plugin/dbLEFDEFImporter.cc
# Sky130 GDS numbers: https://skywater-pdk.readthedocs.io/en/main/rules/layers.html
# KLayout syntax: https://www.klayout.org/svn-public/packages-migrated/refob/load_lefdef_tutorial/tags/1.0/doc/load_lefdef_tutorial.html
# METAL1..METAL5 are aliases matching this project technology LEF.
DIEAREA ALL 235 4

li1 NET,SPNET,VIA 67 20
li1 PIN,LEFPIN 67 16
NAME li1/PIN 67 5
NAME li1/LEFPIN 67 5
li1 LEFOBS,BLOCKAGE 67 10

METAL1 NET,SPNET,VIA 68 20
METAL1 PIN,LEFPIN 68 16
NAME METAL1/PIN 68 5
NAME METAL1/LEFPIN 68 5
METAL1 LEFOBS,BLOCKAGE 68 10

METAL2 NET,SPNET,VIA 69 20
METAL2 PIN,LEFPIN 69 16
NAME METAL2/PIN 69 5
NAME METAL2/LEFPIN 69 5
METAL2 LEFOBS,BLOCKAGE 69 10

METAL3 NET,SPNET,VIA 70 20
METAL3 PIN,LEFPIN 70 16
NAME METAL3/PIN 70 5
NAME METAL3/LEFPIN 70 5
METAL3 LEFOBS,BLOCKAGE 70 10

METAL4 NET,SPNET,VIA 71 20
METAL4 PIN,LEFPIN 71 16
NAME METAL4/PIN 71 5
NAME METAL4/LEFPIN 71 5
METAL4 LEFOBS,BLOCKAGE 71 10

METAL5 NET,SPNET,VIA 72 20
METAL5 PIN,LEFPIN 72 16
NAME METAL5/PIN 72 5
NAME METAL5/LEFPIN 72 5
METAL5 LEFOBS,BLOCKAGE 72 10

mcon VIA 67 44

via VIA 68 44

via2 VIA 69 44

via3 VIA 70 44

via4 VIA 71 44
